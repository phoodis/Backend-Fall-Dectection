# Database (Postgres for Docker, MySQL for remote)
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
# DATABASE_URL=mysql+mysqlconnector://user:pass@host:3306/dbname?ssl_disabled=True

# Flask
SECRET_KEY=your-secret-key
PORT=8932
DEBUG=True
JWT_SECRET_KEY=your-jwt-secret

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CAMERA_MAX_PARALLEL=4
CELERY_WORKER_THREADS=2

# Detection
AI_CONFIDENCE_THRESHOLD=0.5

# Detection Model Paths
BED_EXIT_MODEL_PATH=models/bed_pose_mobilenetv2_3.onnx
FALL_DETECTION_MODEL_PATH=models/fall_detection_model.onnx

# Logging
LOGGING_INTERVAL=60
LOG_RETENTION_DAYS=30

# Notifications
ALERT_START_TIME=8:00
ALERT_END_TIME=20:00
NOTIFICATION_COOLDOWN=600

# LINE Messaging API push notifications (replaces Telegram; app/services/line_service.py). Real values go in the
# server's own env file, never in git.
# Seeds the administrator's switch the first time their settings row is created; the switch that counts afterwards is
# the user's own in the web page "ตั้งค่าการแจ้งเตือน". Left false so a fresh start never pushes to a real phone.
LINE_ENABLED=false
# Channel access token (long-lived) of the one system bot, from the LINE Developers console (Messaging API tab).
# REQUIRED to send anything. Seeds every new user's settings and is used to answer webhook events.
LINE_CHANNEL_ACCESS_TOKEN=
# Seeds the administrator's own LINE user id; ordinary users enter theirs in the web page.
LINE_USER_ID=
# Channel secret (Basic settings tab). Needed by the webhook and the "รับทราบ" button; without it the webhook refuses all calls.
LINE_CHANNEL_SECRET=
# Public HTTPS URL of the tunnel (tools/line_test_proxy.py behind cloudflared). Needed for pictures in LINE and for the
# "รับทราบ" button; blank = text-only alerts. Setting it also makes the backend answer 404 to every path but
# /api/line/webhook and /api/alert-images/ when a request arrives under that host.
PUBLIC_BASE_URL=

# Fall detector for detection_type fall_v2 cameras: v3 = YOLO-pose + temporal CNN (default), v2 = the original ONNX path
FALL_DETECTOR=v3
# v3 runs the profile it was evaluated with unless you set these (defaults live in V3_EVALUATED_PROFILE, app/config.py):
#   V3_IMGSZ=320  V3_TARGET_FPS=8  V3_ROI_IMGSZ=256  V3_ROI_FULL_EVERY=8  V3_THRESHOLD=0.65  V3_PARTIAL_MIN=4
#   V3_PREPROCESS=auto  V3_PREPROCESS_DARK_BELOW=70  V3_POSE_MODEL=yolo26s-pose.pt  V3_CLASSIFIER=fall_classifier_v3.onnx
# A different value is a detector nobody has measured; re-run tools/v3_eval_via_camera_manager.py after changing any of them.
