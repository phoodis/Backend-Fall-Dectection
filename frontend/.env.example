# Copy this file to .env (git ignores .env) and fill in what you need. Never commit real values.

# --- Where the browser sends API calls -------------------------------------------------------
# Option A (recommended, also works through an SSH tunnel): relative path. The Vite dev server
# forwards /api to VITE_PROXY_TARGET below, so the browser only ever talks to localhost:3000
# and no CORS settings are involved.
VITE_API_BASE_URL=/api
# Option B: call the backend directly (the backend must be reachable from the browser):
# VITE_API_BASE_URL=http://127.0.0.1:8932/api
# (127.0.0.1, not localhost: on Windows localhost resolves to ::1 first and Docker Desktop's
# WSL port relay binds IPv6 separately, so requests can hang instead of failing fast.)

# --- Where the dev server forwards /api (used with Option A) ---------------------------------
#   on this computer, or via `ssh -L 8932:localhost:8932 <server>`:  http://127.0.0.1:8932
#   inside docker compose next to the backend service:               http://backend:8932
VITE_PROXY_TARGET=http://127.0.0.1:8932

VITE_APP_NAME=V89 Elderly Surveillance

# --- Firebase (optional) ----------------------------------------------------------------------
# Only the "sign in with Google" button and analytics use it. Leave these empty and the app still
# works with username/password; the Google button then reports that it is not configured.
# Real values come from Firebase Console > Project settings. They belong in your private .env
# only, never in this file and never in git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
